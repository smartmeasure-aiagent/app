APP_ENV=development
# SQLite is the zero-configuration default.
DATABASE_URL=sqlite:///./smart_dustbin.db
# PostgreSQL / Neon. Keep sslmode=require; Neon rejects unencrypted connections.
# Use the -pooler host for the API process. Never commit the real password here.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
POLL_INTERVAL_SECONDS=60
# Voice API upstream, e.g. http://HOST:8031 with the /api/voice/* paths below.
UPSTREAM_API_BASE_URL=
UPSTREAM_STATUS_PATH=/api/voice/status
UPSTREAM_DEVICE_PATH=/api/voice/health
UPSTREAM_HISTORY_PATH=/api/voice/query
# UPSTREAM_API_KEY is sent as the x-api-key header (the voice API's scheme).
# UPSTREAM_API_TOKEN is sent as Authorization: Bearer, for other upstreams.
UPSTREAM_API_KEY=
UPSTREAM_API_TOKEN=
UPSTREAM_TIMEOUT_SECONDS=15

# Live SSE feed. When enabled and a base URL is set, the stream replaces polling.
FLEET_ENABLED=true
FLEET_PATH=/api/fleet
FLEET_POLL_SECONDS=10

UPSTREAM_STREAM_ENABLED=true
UPSTREAM_STREAM_PATH=/api/voice/stream
UPSTREAM_STREAM_INTERVAL=2
# Unchanged readings are not re-stored; one heartbeat row is kept per this interval.
PERSIST_HEARTBEAT_SECONDS=300

# Sarvam AI TTS. Leave blank to fall back to the keyless engines.
# bulbul:v3 speakers include ritu, priya, neha, pooja, simran, kavya (female)
# and aditya, rahul, rohan, amit, dev, varun (male).
SARVAM_API_KEY=sk_6znzwv9p_JFw8DjZUpS0Tqa3uDybtpjyC
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu

GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Reasoning models (gpt-oss) spend tokens before emitting content. Keep the effort
# low and the budget above the reasoning cost, or `content` comes back empty.
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=512

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ADMIN_EMAILS=
CLEANING_EMAILS=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_PHONE_NUMBERS=
CLEANING_PHONE_NUMBERS=
